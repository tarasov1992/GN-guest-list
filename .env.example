# Postgres container
POSTGRES_USER=checkin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=checkin

# Caddy: the address it serves.
# Server: the VPS IP with dashes + .sslip.io, e.g. 203-0-113-7.sslip.io (gets HTTPS automatically)
# Local:  :80 (plain HTTP on http://localhost)
SITE_ADDRESS=:80

# App
# Admin login: username "admin", this password. At least 16 characters: openssl rand -base64 24
ADMIN_PASSWORD=change-me
# Door page lives at /d/<DOOR_SECRET>/. At least 16 characters of A-Z a-z 0-9 _ -: openssl rand -hex 16
DOOR_SECRET=change-me

# YD
YANDEX_URL=https://disk.yandex.ru/i/change-me
# Optional, default 1h, minimum 1m
# SYNC_INTERVAL=1h

# GD
GOOGLE_URL=https://docs.google.com/spreadsheets/d/change-me

# File
SOURCE=change-me